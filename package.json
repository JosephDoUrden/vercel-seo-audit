{
  "name": "vercel-seo-audit",
  "version": "2.18.0",
  "description": "CLI tool that diagnoses SEO and indexing issues for Next.js/Vercel websites",
  "type": "module",
  "bin": {
    "vercel-seo-audit": "./bin/vercel-seo-audit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node bin/vercel-seo-audit.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p action",
    "lint": "tsc --noEmit && tsc -p action"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "seo",
    "audit",
    "vercel",
    "nextjs",
    "cli"
  ],
  "author": "JosephDoUrden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephDoUrden/vercel-seo-audit.git"
  },
  "homepage": "https://github.com/JosephDoUrden/vercel-seo-audit#readme",
  "bugs": {
    "url": "https://github.com/JosephDoUrden/vercel-seo-audit/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "htmlparser2": "^10.1.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
